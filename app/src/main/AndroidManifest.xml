<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacy: this app has no INTERNET permission, so it cannot send anything off the
  phone. Its only permission opens Android's uninstall confirmation.
  scripts/check-permissions.sh verifies this on every build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets "Uninstall" open Android's own confirmation screen. Nothing is removed without it. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Only to put a Dotline wallpaper on the lock screen when asked. It can't read anything. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Lets LauncherApps list every launchable app (package-visibility rules, Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Used only to pick sensible default dock apps (dialer, browser, camera). -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <!-- So tapping the clock, alarm and calendar tiles can find those apps. -->
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="com.android.calendar" />
        </intent>
    </queries>

    <application
        android:name=".DotlineApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dotline">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Tiles for the phone's pull-down panel. Only the system can bind them; no permission is requested. -->
        <service
            android:name=".tiles.WallpaperTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_wallpaper"
            android:label="Next wallpaper"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tiles.RamTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_ram"
            android:label="RAM"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Lets the phone's own Wallpaper app read the one lock-screen image Dotline made. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>
</manifest>
